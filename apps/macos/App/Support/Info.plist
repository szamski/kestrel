<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Kestrel links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kestrel</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>T3ConnectClerkJWTTemplate</key>
	<string>$(T3_CONNECT_CLERK_JWT_TEMPLATE)</string>
	<key>T3ConnectClerkPublishableKey</key>
	<string>$(T3_CONNECT_CLERK_PUBLISHABLE_KEY)</string>
	<key>T3ConnectRelayHost</key>
	<string>$(T3_CONNECT_RELAY_HOST)</string>
	<key>T3RepoRoot</key>
	<string>$(T3_REPO_ROOT)</string>
</dict>
</plist>
